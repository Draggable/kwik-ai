<?xml version="1.0"?>
<ruleset name="Kwik AI Tags">
    <description>PHP_CodeSniffer configuration for Kwik AI Tags WordPress plugin.</description>

    <!-- Scan these directories -->
    <file>.</file>

    <!-- Exclude non-PHP and third-party code -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>dist/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>test-*.php</exclude-pattern>

    <!-- Only check PHP files -->
    <arg name="extensions" value="php" />

    <!-- PHP Compatibility checking -->
    <config name="testVersion" value="8.0-" />
    <rule ref="PHPCompatibility" />

    <!-- Critical WordPress security sniffs only -->
    <rule ref="WordPress.Security.EscapeOutput" />
    <rule ref="WordPress.Security.NonceVerification" />
    <rule ref="WordPress.Security.ValidatedSanitizedInput" />
    <rule ref="WordPress.WP.DeprecatedFunctions" />

    <!-- Show progress -->
    <arg value="ps" />
    <arg name="colors" />

    <!-- Enable caching -->
    <arg name="cache" value=".phpcs.cache" />
</ruleset>
