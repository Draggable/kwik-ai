{
  "name": "kwik-ai/kwik-ai",
  "description": "AI-powered tag and description generation for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/php-compatibility": "^9.3",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html=tests/coverage --coverage-text",
    "test:integration": "vendor/bin/phpunit tests/integration",
    "test:unit": "vendor/bin/phpunit tests/unit",
    "lint": "vendor/bin/phpcs",
    "lint:fix": "vendor/bin/phpcbf",
    "lint:php": "vendor/bin/phpcs --standard=PHPCompatibility",
    "lint:wp": "vendor/bin/phpcs --standard=WordPress"
  }
}
